# Frontend GStock en production. TLS est terminé par le proxy de Coolify (Traefik) :
# Caddy écoute en HTTP et fait confiance aux en-têtes X-Forwarded-* du réseau privé.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	respond /healthz 200

	# API, cookie CSRF et photos : transmis à Laravel avec le Host d'origine (l'espace = sous-domaine).
	@backend path /api/* /sanctum/* /storage/*
	handle @backend {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv
		# Fichiers à nom versionné : cache long ; le reste (index.html, sw.js, manifeste) toujours revalidé.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin
		try_files {path} /index.html
		file_server
	}
}
