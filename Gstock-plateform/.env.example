APP_NAME=GStock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gstock.localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=gstock
DB_USERNAME=gstock
DB_PASSWORD=gstock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Espaces (ADR-009) : un espace = un sous-domaine du domaine central.
# En développement, le frontend tourne sur http://<espace>.localhost:5173.
TENANCY_CENTRAL_DOMAINS=localhost
SANCTUM_STATEFUL_DOMAINS=*.localhost,*.localhost:*
# Adresse des écrans du commerçant ({tenant} = sous-domaine), pour les liens envoyés par e-mail.
FRONTEND_URL=http://{tenant}.localhost:5173

# Abonnements GeniusPay (clés de Genius Groups, ADR-003), dashboard GeniusPay → Paramètres → API.
# Avec des clés, le vrai GeniusPay est utilisé (sandbox ou live selon les clés) ; sans clés, la page
# de paiement simulée (hors production). GENIUSPAY_PLATFORM_DRIVER=simulation force la simulation.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# Secret des webhooks (whsec_…) : `php artisan gstock:geniuspay-webhook https://<domaine>/api/v1/webhooks/geniuspay/platform`.
GENIUSPAY_WEBHOOK_SECRET=

# Back-office Filament (M01) : domaine en production (ex. admin.gstock.app), chemin /admin sinon.
ADMIN_DOMAIN=
